# Local mode: leave this blank. Vite proxies /api and /media to your PC.
VITE_BACKEND_ORIGIN=

# Public build setting, never a password or API key.
# Hosted mode: copy to .env.hosted.local and set your protected HTTPS origin.
# VITE_BACKEND_ORIGIN=https://api.example.com
# Project Pages normally uses /repository-name/; a custom domain uses /.
# ELDORIA_PUBLIC_BASE=/eldoria/
