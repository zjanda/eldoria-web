# Public deployment settings only. Login and provider secrets never belong here.
VITE_BACKEND_ORIGIN=https://eldoria-api.jandalisoftware.com
ELDORIA_PUBLIC_BASE=/
# The OAuth client id for Sign in with Google: public, not a secret (Google shows it to every visitor).
# Left empty until the Google Cloud client exists; the Pages workflow sets it from the repository
# variable ELDORIA_GOOGLE_CLIENT_ID. Empty: the title screen shows no Google button.
VITE_GOOGLE_CLIENT_ID=
